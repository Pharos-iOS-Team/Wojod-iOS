            <string>Inter-Bold</string>
        </array>
        <array key="Inter-ExtraBold.ttf">
            <string>Inter-ExtraBold</string>
        </array>
        <array key="Inter-Regular.ttf">
            <string>Inter-Regular</string>
        </array>
    </customFonts>
    <scenes>
        <!--Password View Controller-->
        <scene sceneID="pwd-scene-01">
            <objects>
                <viewController storyboardIdentifier="PasswordViewController" useStoryboardIdentifierAsRestorationIdentifier="YES" id="pwd-vc-01" customClass="PasswordViewController" customModule="Wojood" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="pwd-view-01">
                        <rect key="frame" x="0.0" y="0.0" width="390" height="844"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="pwd-scroll-01">
                                <rect key="frame" x="0.0" y="94" width="390" height="750"/>
                                <subviews>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="pwd-content-01">
                                        <rect key="frame" x="0.0" y="0.0" width="390" height="750"/>
                                        <subviews>
                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="CoursesLogo" translatesAutoresizingMaskIntoConstraints="NO" id="pwd-logo-01">
                                                <rect key="frame" x="39" y="30" width="70" height="70"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="70" id="pwd-logo-h"/>
                                                    <constraint firstAttribute="width" constant="70" id="pwd-logo-w"/>
                                                </constraints>
                                            </imageView>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="3" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="pwd-welcome-label-01">
                                                <rect key="frame" x="39" y="135" width="312" height="70"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="70" id="pwd-welcome-label-h"/>
                                                </constraints>
                                                <fontDescription key="fontDescription" name="Inter-Bold" family="Inter" pointSize="22"/>
                                                <color key="textColor" red="0.1019607843" green="0.1176470588" blue="0.1333333333" alpha="1" colorSpace="calibratedRGB"/>
                                                <nil key="highlightedColor"/>
                                            </label>
                                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="15" translatesAutoresizingMaskIntoConstraints="NO" id="pwd-stack-01">
                                                <rect key="frame" x="39" y="259" width="312" height="115"/>
                                                <subviews>
                                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="pwd-alert-01" customClass="AlertView" customModule="Wojood" customModuleProvider="target">
                                                        <rect key="frame" x="0.0" y="0.0" width="312" height="50"/>
                                                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="50" id="pwd-alert-h"/>
                                                        </constraints>
                                                    </view>
                                                    <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="left" contentVerticalAlignment="center" borderStyle="roundedRect" placeholder="Password" textAlignment="natural" minimumFontSize="17" translatesAutoresizingMaskIntoConstraints="NO" id="pwd-field-01">
                                                        <rect key="frame" x="0.0" y="65" width="312" height="50"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="50" id="pwd-field-h"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                                        <textInputTraits key="textInputTraits" secureTextEntry="YES"/>
                                                    </textField>
                                                </subviews>
                                            </stackView>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="pwd-login-btn-01" customClass="SendButton" customModule="Wojood" customModuleProvider="target">
                                                <rect key="frame" x="39" y="389" width="312" height="50"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="50" id="pwd-login-btn-h"/>
                                                </constraints>
                                                <state key="normal" title="Button"/>
                                                <connections>
                                                    <action selector="login:" destination="pwd-vc-01" eventType="touchUpInside" id="pwd-login-action"/>
                                                </connections>
                                            </button>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="right" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="pwd-forgot-btn-01">
                                                <rect key="frame" x="39" y="469" width="312" height="29"/>
                                                <fontDescription key="fontDescription" name="Inter-Regular" family="Inter" pointSize="14"/>
                                                <state key="normal" title="Forgot password?">
                                                    <color key="titleColor" red="0.14901960784313725" green="0.14901960784313725" blue="0.14901960784313725" alpha="1" colorSpace="calibratedRGB"/>
                                                </state>
                                                <connections>
                                                    <action selector="forgotPassword:" destination="pwd-vc-01" eventType="touchUpInside" id="pwd-forgot-action"/>
                                                </connections>
                                            </button>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="01206425318" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="pwd-phone-label-01">
                                                <rect key="frame" x="39" y="220" width="312" height="24"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="24" id="pwd-phone-label-h"/>
                                                </constraints>
                                                <fontDescription key="fontDescription" name="Inter-ExtraBold" family="Inter" pointSize="16"/>
                                                <color key="textColor" red="0.57619793653488161" green="0.57619793653488161" blue="0.57619793653488161" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                <color key="highlightedColor" white="0.33333333329999998" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                            </label>
                                        </subviews>
                                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                        <constraints>
                                            <constraint firstItem="pwd-phone-label-01" firstAttribute="top" secondItem="pwd-welcome-label-01" secondAttribute="bottom" constant="15" id="688-tc-95q"/>
                                            <constraint firstItem="pwd-stack-01" firstAttribute="top" secondItem="pwd-phone-label-01" secondAttribute="bottom" constant="15" id="68g-Xh-73x"/>
                                            <constraint firstItem="pwd-welcome-label-01" firstAttribute="top" secondItem="pwd-logo-01" secondAttribute="bottom" constant="35" id="U0e-9o-r5c"/>
                                            <constraint firstItem="pwd-forgot-btn-01" firstAttribute="leading" secondItem="pwd-content-01" secondAttribute="leading" constant="39" id="pwd-forgot-lead"/>
                                            <constraint firstItem="pwd-forgot-btn-01" firstAttribute="top" secondItem="pwd-login-btn-01" secondAttribute="bottom" constant="30" id="pwd-forgot-top"/>
                                            <constraint firstAttribute="trailing" secondItem="pwd-forgot-btn-01" secondAttribute="trailing" constant="39" id="pwd-forgot-trail"/>
                                            <constraint firstItem="pwd-login-btn-01" firstAttribute="leading" secondItem="pwd-content-01" secondAttribute="leading" constant="39" id="pwd-login-lead"/>
                                            <constraint firstItem="pwd-login-btn-01" firstAttribute="top" secondItem="pwd-stack-01" secondAttribute="bottom" constant="15" id="pwd-login-top"/>
                                            <constraint firstAttribute="trailing" secondItem="pwd-login-btn-01" secondAttribute="trailing" constant="39" id="pwd-login-trail"/>
                                            <constraint firstItem="pwd-logo-01" firstAttribute="leading" secondItem="pwd-content-01" secondAttribute="leading" constant="39" id="pwd-logo-lead"/>
                                            <constraint firstItem="pwd-logo-01" firstAttribute="top" secondItem="pwd-content-01" secondAttribute="top" constant="30" id="pwd-logo-top"/>
                                            <constraint firstItem="pwd-phone-label-01" firstAttribute="leading" secondItem="pwd-content-01" secondAttribute="leading" constant="39" id="pwd-phone-lead"/>
                                            <constraint firstAttribute="trailing" secondItem="pwd-phone-label-01" secondAttribute="trailing" constant="39" id="pwd-phone-trail"/>
                                            <constraint firstItem="pwd-stack-01" firstAttribute="leading" secondItem="pwd-content-01" secondAttribute="leading" constant="39" id="pwd-stack-lead"/>
                                            <constraint firstAttribute="trailing" secondItem="pwd-stack-01" secondAttribute="trailing" constant="39" id="pwd-stack-trail"/>
                                            <constraint firstItem="pwd-welcome-label-01" firstAttribute="leading" secondItem="pwd-content-01" secondAttribute="leading" constant="39" id="pwd-welcome-lead"/>
                                            <constraint firstAttribute="trailing" secondItem="pwd-welcome-label-01" secondAttribute="trailing" constant="39" id="pwd-welcome-trail"/>
                                        </constraints>
                                    </view>
                                </subviews>
                                <constraints>
                                    <constraint firstAttribute="bottom" secondItem="pwd-content-01" secondAttribute="bottom" constant="50" id="pwd-content-bottom"/>
                                    <constraint firstItem="pwd-content-01" firstAttribute="centerX" secondItem="pwd-scroll-01" secondAttribute="centerX" id="pwd-content-centerX"/>
                                    <constraint firstItem="pwd-content-01" firstAttribute="centerY" secondItem="pwd-scroll-01" secondAttribute="centerY" id="pwd-content-centerY"/>
                                    <constraint firstItem="pwd-content-01" firstAttribute="leading" secondItem="pwd-scroll-01" secondAttribute="leading" id="pwd-content-lead"/>
                                    <constraint firstItem="pwd-content-01" firstAttribute="top" secondItem="pwd-scroll-01" secondAttribute="top" id="pwd-content-top"/>
                                    <constraint firstAttribute="trailing" secondItem="pwd-content-01" secondAttribute="trailing" id="pwd-content-trail"/>
                                </constraints>
